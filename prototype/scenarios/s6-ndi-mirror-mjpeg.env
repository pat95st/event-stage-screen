# Mirror case: both outputs render the same scene with the same NDI source (one shared MJPEG pipeline).
# Output 2 additionally flips the video horizontally (teleprompter case).
REQUIRES_NDI=1
OUT1_MODE=1920x1080@60
OUT2_MODE=1280x720@60
OUT1_TRANSPORT=mjpeg
OUT1_SOURCE=ndi
OUT1_FORMAT=1920x1080@30
OUT2_TRANSPORT=mjpeg
OUT2_SOURCE=ndi
OUT2_FORMAT=1920x1080@30
OUT2_VFLIP=1
